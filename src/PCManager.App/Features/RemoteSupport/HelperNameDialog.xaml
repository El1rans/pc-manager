<Window x:Class="PCManager.App.Features.RemoteSupport.HelperNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change helper name" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Helper's first name" Margin="0,0,0,8"/>
        <TextBox x:Name="NameTextBox" FontSize="16" Padding="6"/>
        <TextBlock Text="Leave this empty to stop showing a helper name."
                   Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" Click="Ok_Click" IsDefault="True"
                    Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                    Foreground="White" BorderThickness="0" Padding="16,6"/>
        </StackPanel>
    </StackPanel>
</Window>
