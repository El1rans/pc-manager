<UserControl x:Class="PCManager.App.Features.RemoteSupport.RemoteSupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PCManager.App.Controls"
             xmlns:rs="clr-namespace:PCManager.App.Features.RemoteSupport"
             d:DataContext="{d:DesignInstance rs:RemoteSupportViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="24,24,24,24">
            <TextBlock Text="Get help" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Get remote help from someone you trust, in two clicks."
                       Style="{StaticResource Secondary}" Margin="0,4,0,20" TextWrapping="Wrap"/>

            <!-- State 1 / 3 (not installed, or an install/detection error): reuse the shared
                 ComponentCard, styled larger for this page via the ScaleTransform below - it already
                 covers "Not installed" with Install + progress/log, and an error with Retry. -->
            <Border Visibility="{Binding ShowComponentCard, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                </Border.LayoutTransform>
                <controls:ComponentCard DataContext="{Binding Card}" Width="440"/>
            </Border>

            <!-- State 2 (installed): the address and everything else the user actually needs. -->
            <StackPanel Visibility="{Binding ShowMainContent, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Your address" Style="{StaticResource CardTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding FormattedAddress, Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="40" FontWeight="SemiBold" VerticalAlignment="Center"
                                     Visibility="{Binding HasAddress, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Column="0" Text="Getting your address..."
                                       Style="{StaticResource Secondary}" FontSize="20" VerticalAlignment="Center"
                                       Visibility="{Binding HasAddress, Converter={StaticResource InverseBoolToVis}}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Copied" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Visibility="{Binding IsAddressCopied, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Copy address" Command="{Binding CopyAddressCommand}"
                                        IsEnabled="{Binding HasAddress}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="16" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Start AnyDesk" Command="{Binding StartAnyDeskCommand}"
                                    Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="How it works" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="1. Call the person helping you." TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="2. Read them this number." TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap"
                                   Text="3. When AnyDesk asks, click Accept only if you are talking to them right now."/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Never accept a connection from someone who called you unexpectedly. Real companies (banks, Microsoft) will not ask you to install AnyDesk."/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Share" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Copy your computer name, Windows version and AnyDesk address to send by message."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Copied" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       Visibility="{Binding IsSupportInfoCopied, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Copy support info" Command="{Binding CopySupportInfoCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Helper" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Their first name, shown on this page so it is clear who to expect."/>
                        <TextBox Text="{Binding HelperName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxWidth="240" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
