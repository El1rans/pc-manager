<UserControl x:Class="PCManager.App.Features.RemoteSupport.RemoteSupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PCManager.App.Controls"
             xmlns:rs="clr-namespace:PCManager.App.Features.RemoteSupport"
             d:DataContext="{d:DesignInstance rs:RemoteSupportViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="24,24,24,24">
            <TextBlock Text="Get help" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Get remote help from someone you trust, in two clicks."
                       Style="{StaticResource Secondary}" Margin="0,4,0,8" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="{Binding HelperLine}" VerticalAlignment="Center" Margin="0,0,12,0"
                           FontWeight="SemiBold"
                           Visibility="{Binding HasHelperName, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Change helper name" Click="ChangeHelperNameButton_Click"
                        BorderThickness="0" Background="Transparent" Padding="0" Cursor="Hand"
                        Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
            </StackPanel>

            <!-- State 1 / 3 (not installed, or an install/detection error): reuse the shared
                 ComponentCard, styled larger for this page via the ScaleTransform below - it already
                 covers "Not installed" with Install + progress/log, and an error with Retry. -->
            <StackPanel Visibility="{Binding ShowComponentCard, Converter={StaticResource BoolToVis}}">
                <Border HorizontalAlignment="Left">
                    <Border.LayoutTransform>
                        <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                    </Border.LayoutTransform>
                    <controls:ComponentCard DataContext="{Binding Card}" Width="440"/>
                </Border>

                <TextBlock Margin="0,16,0,0" Visibility="{Binding ShowManualDownloadLink, Converter={StaticResource BoolToVis}}">
                    <Run Text="Or download AnyDesk yourself from "/>
                    <Hyperlink Command="{Binding DownloadAnyDeskManuallyCommand}">anydesk.com/download</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- State 2 (installed): the address and everything else the user actually needs. -->
            <StackPanel Visibility="{Binding ShowMainContent, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Your address" Style="{StaticResource CardTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding FormattedAddress, Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="40" FontWeight="SemiBold" VerticalAlignment="Center"
                                     Visibility="{Binding HasAddress, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Column="0" Text="Getting your address..."
                                       Style="{StaticResource Secondary}" FontSize="20" VerticalAlignment="Center"
                                       Visibility="{Binding HasAddress, Converter={StaticResource InverseBoolToVis}}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                            Visibility="{Binding IsAddressCopied, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Copied" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Couldn't copy. Please try again."
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="140"
                                           Visibility="{Binding AddressCopyFailed, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Copy address" Command="{Binding CopyAddressCommand}"
                                        IsEnabled="{Binding HasAddress}"
                                        Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                        Foreground="White" BorderThickness="0"
                                        Padding="24,12" FontSize="18"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0" Visibility="{Binding HasLoadedState, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="16" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Start AnyDesk" Command="{Binding StartAnyDeskCommand}"
                                    Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <Border Margin="0,16,0,0" Padding="12" CornerRadius="6"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="1"
                                Visibility="{Binding ShowAddressTrouble, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding AddressTroubleMessage}" TextWrapping="Wrap"/>
                                <Button Content="Try again" Command="{Binding TryAgainCommand}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="How it works" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding Step1Text}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="2. Read them the number above." FontSize="16" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock FontSize="16" TextWrapping="Wrap"
                                   Text="3. When AnyDesk asks, click Accept only if you are talking to them right now."/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <TextBlock FontSize="16" TextWrapping="Wrap">
                            <Run FontWeight="Bold" Text="Be careful: "/>
                            <Run Text="Never accept a connection from someone who called you unexpectedly. Real companies (banks, Microsoft) will not ask you to install AnyDesk."/>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Share" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Copy your computer name, Windows version and AnyDesk address to send by message."/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                        Visibility="{Binding IsSupportInfoCopied, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,4,0"/>
                                <TextBlock Text="Copied" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Couldn't copy. Please try again."
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Margin="0,0,10,0" VerticalAlignment="Center"
                                       Visibility="{Binding SupportInfoCopyFailed, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Copy support info" Command="{Binding CopySupportInfoCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
