<Window x:Class="PCManager.App.Features.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:setup="clr-namespace:PCManager.App.Features.Setup"
        d:DataContext="{d:DesignInstance setup:SetupViewModel}"
        mc:Ignorable="d"
        Title="Choose what to set up" Height="480" Width="560" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Choose what to set up" Style="{StaticResource PageTitle}" FontSize="20"/>
            <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="PC Manager can install these optional tools now, or you can set them up later from Settings."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,12,0"
                                          IsChecked="{Binding IsSelected}"
                                          IsEnabled="{Binding IsAlreadyInstalled, Converter={StaticResource InverseBool}}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlreadyInstalled}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Skip" Command="{Binding SkipCommand}"
                    Visibility="{Binding ShowSkip, Converter={StaticResource BoolToVis}}"/>
            <Button DockPanel.Dock="Right" Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryActionCommand}"
                    Style="{DynamicResource AccentButtonStyle}"/>
        </DockPanel>
    </Grid>
</Window>
