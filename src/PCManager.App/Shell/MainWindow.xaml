<Window x:Class="PCManager.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:PCManager.App.Shell"
        d:DataContext="{d:DesignInstance shell:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PC Manager" Height="720" Width="1180" MinHeight="600" MinWidth="900"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="PC Manager" Style="{StaticResource CardTitle}"
                           Margin="16,20,16,16" FontSize="18"/>

                <Border DockPanel.Dock="Bottom" Padding="12" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding AdminStatusText}" Style="{StaticResource Secondary}"
                                   Margin="4,0,4,8" TextWrapping="Wrap"/>
                        <Button Content="Restart as admin"
                                Command="{Binding RestartElevatedCommand}"
                                Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVis}}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Content="Set up optional features"
                                Command="{Binding OpenSetupCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Pinned pages (e.g. "Get help"): their own group at the very bottom of the rail,
                     above the admin block, separated and styled distinctly - see
                     IPage.IsPinnedToBottom. Docked before the fill ListBox below so it stacks just
                     above the (already Bottom-docked) admin block. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Margin="12,4,12,4"/>
                    <ListBox ItemsSource="{Binding PinnedPages}" SelectedItem="{Binding SelectedPage}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}" Style="{StaticResource Icon}"
                                               FontSize="16" Margin="4,0,12,0"
                                               Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Style="{StaticResource Icon}"
                                           FontSize="16" Margin="4,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="8" Padding="6,2" Margin="8,0,0,0"
                                        Visibility="{Binding Badge, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding SelectedPageView}" Margin="24"/>
    </Grid>
</Window>
