<UserControl x:Class="PCManager.App.Controls.AdminRequiredBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Message, ElementName=Root}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="2" Content="Restart as administrator"
                    Command="{Binding RestartCommand, ElementName=Root}"
                    VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
    </Border>
</UserControl>
