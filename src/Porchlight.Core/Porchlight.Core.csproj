<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Porchlight.Core</RootNamespace>
    <AssemblyName>Porchlight.Core</AssemblyName>
    <!-- CA1716: IHardwareService.Stop() intentionally mirrors Start()/Stop() from spec 04; VB's
         reserved "Stop" statement is not a realistic concern for this app. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored, not a NuGet package - see src/ThirdParty/OpenRGB.NET/OpenRGB.NET.csproj and
         THIRD-PARTY-NOTICES.md for why. -->
    <ProjectReference Include="..\ThirdParty\OpenRGB.NET\OpenRGB.NET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The read-only web console's browser page (see WebConsole/WebConsoleRouter.cs), served from
         memory so nothing needs to be installed next to the exe. -->
    <EmbeddedResource Include="WebConsole\Assets\*" LogicalName="Porchlight.WebConsole.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
