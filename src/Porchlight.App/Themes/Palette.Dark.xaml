<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Vivid colour palette, dark theme.
       Not merged into App.xaml: ThemePalette copies these entries into Application.Resources whenever the
       effective theme changes, so they win over the Fluent theme dictionary. Keep the key set identical to
       Palette.Light.xaml. See docs/specs/40-vivid-colour.md. -->

  <!-- Porchlight amber replaces the Windows accent: every Fluent accent brush (buttons, toggles,
       progress bars, focus) is derived from these. -->
  <Color x:Key="SystemAccentColorLight3">#FFFFE7AE</Color>
  <Color x:Key="SystemAccentColorLight2">#FFF5B942</Color>
  <Color x:Key="SystemAccentColorLight1">#FFE8A317</Color>
  <Color x:Key="SystemAccentColor">#FFD18B0B</Color>
  <Color x:Key="SystemAccentColorDark1">#FFA86B00</Color>
  <Color x:Key="SystemAccentColorDark2">#FF855300</Color>
  <Color x:Key="SystemAccentColorDark3">#FF5E3B00</Color>

  <!-- Per-category hues (Controls/Hue.cs): solid, a soft tint for icon chips and selected rows, a wash
       that fades out across a card, and a stroke for that card's border. -->
  <Color x:Key="HueAmberColor">#FFF5B942</Color>
  <SolidColorBrush x:Key="HueAmberBrush" Color="#FFF5B942"/>
  <SolidColorBrush x:Key="HueAmberTintBrush" Color="#2EF5B942"/>
  <SolidColorBrush x:Key="HueAmberStrokeBrush" Color="#4DF5B942"/>
  <LinearGradientBrush x:Key="HueAmberWashBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#38F5B942" Offset="0"/>
    <GradientStop Color="#00F5B942" Offset="0.75"/>
  </LinearGradientBrush>
  <Color x:Key="HueBlueColor">#FF5AA9FF</Color>
  <SolidColorBrush x:Key="HueBlueBrush" Color="#FF5AA9FF"/>
  <SolidColorBrush x:Key="HueBlueTintBrush" Color="#2E5AA9FF"/>
  <SolidColorBrush x:Key="HueBlueStrokeBrush" Color="#4D5AA9FF"/>
  <LinearGradientBrush x:Key="HueBlueWashBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#385AA9FF" Offset="0"/>
    <GradientStop Color="#005AA9FF" Offset="0.75"/>
  </LinearGradientBrush>
  <Color x:Key="HueVioletColor">#FFB48CFF</Color>
  <SolidColorBrush x:Key="HueVioletBrush" Color="#FFB48CFF"/>
  <SolidColorBrush x:Key="HueVioletTintBrush" Color="#2EB48CFF"/>
  <SolidColorBrush x:Key="HueVioletStrokeBrush" Color="#4DB48CFF"/>
  <LinearGradientBrush x:Key="HueVioletWashBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#38B48CFF" Offset="0"/>
    <GradientStop Color="#00B48CFF" Offset="0.75"/>
  </LinearGradientBrush>
  <Color x:Key="HueGreenColor">#FF4CD68F</Color>
  <SolidColorBrush x:Key="HueGreenBrush" Color="#FF4CD68F"/>
  <SolidColorBrush x:Key="HueGreenTintBrush" Color="#2E4CD68F"/>
  <SolidColorBrush x:Key="HueGreenStrokeBrush" Color="#4D4CD68F"/>
  <LinearGradientBrush x:Key="HueGreenWashBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#384CD68F" Offset="0"/>
    <GradientStop Color="#004CD68F" Offset="0.75"/>
  </LinearGradientBrush>
  <Color x:Key="HueTealColor">#FF3CC8C8</Color>
  <SolidColorBrush x:Key="HueTealBrush" Color="#FF3CC8C8"/>
  <SolidColorBrush x:Key="HueTealTintBrush" Color="#2E3CC8C8"/>
  <SolidColorBrush x:Key="HueTealStrokeBrush" Color="#4D3CC8C8"/>
  <LinearGradientBrush x:Key="HueTealWashBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#383CC8C8" Offset="0"/>
    <GradientStop Color="#003CC8C8" Offset="0.75"/>
  </LinearGradientBrush>
  <Color x:Key="HueCoralColor">#FFFF8E66</Color>
  <SolidColorBrush x:Key="HueCoralBrush" Color="#FFFF8E66"/>
  <SolidColorBrush x:Key="HueCoralTintBrush" Color="#2EFF8E66"/>
  <SolidColorBrush x:Key="HueCoralStrokeBrush" Color="#4DFF8E66"/>
  <LinearGradientBrush x:Key="HueCoralWashBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#38FF8E66" Offset="0"/>
    <GradientStop Color="#00FF8E66" Offset="0.75"/>
  </LinearGradientBrush>
  <Color x:Key="HueNeutralColor">#FFC5C5C5</Color>
  <SolidColorBrush x:Key="HueNeutralBrush" Color="#FFC5C5C5"/>
  <SolidColorBrush x:Key="HueNeutralTintBrush" Color="#2EC5C5C5"/>
  <SolidColorBrush x:Key="HueNeutralStrokeBrush" Color="#4DC5C5C5"/>
  <LinearGradientBrush x:Key="HueNeutralWashBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#38C5C5C5" Offset="0"/>
    <GradientStop Color="#00C5C5C5" Offset="0.75"/>
  </LinearGradientBrush>

  <!-- The warm "porch light" glow behind the page header. -->
  <RadialGradientBrush x:Key="BrandGlowBrush" Center="0.25,0.3" GradientOrigin="0.25,0.3" RadiusX="0.75" RadiusY="0.7">
    <GradientStop Color="#30F5B942" Offset="0"/>
    <GradientStop Color="#00F5B942" Offset="1"/>
  </RadialGradientBrush>
</ResourceDictionary>
