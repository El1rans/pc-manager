<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Porchlight.App</RootNamespace>
    <AssemblyName>Porchlight</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\brand\porchlight.ico</ApplicationIcon>
    <!-- WPF0001: the Fluent ThemeMode API (Application.ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Size: the UI is English-only, so skip the 13 WPF/runtime satellite resource languages
       (~9 MB). Deliberately NOT EnableCompressionInSingleFile: it halves the exe on disk, but the
       LZMA2 installer then grows (~41 -> ~55 MB, since deflated data does not recompress), and it
       costs ~65 MB extra private memory plus ~200 ms startup to decompress assemblies. Trimming
       is not an option - WPF does not support it. -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- LibreHardwareMonitorLib depends on Mono.Posix for its Linux code paths; its native helper
       libraries are only P/Invoked there and are dead weight in a Windows-only build. -->
  <Target Name="DropLinuxOnlyNativeLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'libMonoPosixHelper' Or '%(Filename)' == 'MonoPosixHelper'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <!-- Used directly in App.xaml.cs to wrap the bootstrap Serilog logger as an ILogger for
         AppDataMigrator, before the DI container (and its own Serilog->ILogger wiring, via
         Serilog.Extensions.Hosting) exists. -->
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window/taskbar icon (WPF's Window.Icon does not fall back to the exe's ApplicationIcon
         resource above - it must be set explicitly, see MainWindow.xaml/SetupWindow.xaml). -->
    <Resource Include="..\..\assets\brand\porchlight.ico" Link="Assets\porchlight.ico" />
    <!-- Small icon shown next to the "Porchlight" wordmark in the sidebar header - see
         MainWindow.xaml. -->
    <Resource Include="..\..\assets\brand\porchlight-icon-64.png" Link="Assets\porchlight-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Porchlight.Core\Porchlight.Core.csproj" />
  </ItemGroup>

</Project>
