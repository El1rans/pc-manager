<UserControl x:Class="Porchlight.App.Controls.ColorWheelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Hue/saturation wheel: a bitmap generated once per size (see code-behind), with a
             draggable/keyboard-movable thumb overlaid on a transparent Canvas. -->
        <Border x:Name="WheelBorder" Grid.Column="0" Width="150" Height="150"
                Focusable="True" SnapsToDevicePixels="True"
                AutomationProperties.Name="Color wheel"
                AutomationProperties.HelpText="Drag, or use arrow keys, to choose a hue and saturation">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    <Setter Property="CornerRadius" Value="75"/>
                    <Setter Property="Cursor" Value="Cross"/>
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Image x:Name="WheelImage" Stretch="Fill"/>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="Thumb" Width="14" Height="14" StrokeThickness="2" Stroke="White">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.6"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Width="150">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border x:Name="PreviewSwatch" Width="36" Height="36" Margin="0,0,10,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        AutomationProperties.Name="Selected color preview"/>
                <TextBox x:Name="HexBox" VerticalAlignment="Center" Width="90" MaxLength="7"
                         AutomationProperties.Name="Color (hex)"/>
            </StackPanel>

            <TextBlock Text="Value" Style="{StaticResource Secondary}" Margin="0,0,0,4"/>
            <Slider x:Name="ValueSlider" Minimum="0" Maximum="100" Value="100"
                    AutomationProperties.Name="Color value (brightness of the picked hue)"/>
        </StackPanel>
    </Grid>
</UserControl>
