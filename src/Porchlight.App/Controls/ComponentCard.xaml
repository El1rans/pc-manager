<UserControl x:Class="Porchlight.App.Controls.ComponentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Porchlight.App.Controls"
             d:DataContext="{d:DesignInstance controls:ComponentCardViewModel}"
             mc:Ignorable="d" d:DesignWidth="420">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE774;" Style="{StaticResource Icon}"
                           FontSize="22" Margin="0,0,12,0" VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitle}" Margin="0"/>
                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="14" Margin="0,0,6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xE783;"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                        <Setter Property="Text" Value="&#xE73E;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInstalledNotRunning}" Value="True">
                                        <Setter Property="Text" Value="&#xE946;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Text" Value="&#xE783;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="{Binding PrimaryButtonText}"
                        Command="{Binding PrimaryActionCommand}"
                        Visibility="{Binding ShowPrimaryButton, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <ProgressBar Height="4" IsIndeterminate="True" BorderThickness="0"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Secondary}"
                           FontFamily="Consolas" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                <Expander Header="Log" Margin="0,6,0,0" FontSize="11">
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11"/>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
