<UserControl x:Class="Porchlight.App.Features.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Porchlight.App.Controls"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:dashboard="clr-namespace:Porchlight.App.Features.Dashboard"
             d:DataContext="{d:DesignInstance dashboard:DashboardViewModel}"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700">

    <UserControl.Resources>

        <!-- Each tile in its own colour (docs/specs/40-vivid-colour.md): icon chip, value, sparkline,
             tinted border and a wash fading across the card. The title still names the metric, so
             colour is never the only cue. -->
        <DataTemplate DataType="{x:Type dashboard:MetricTileViewModel}">
            <Border Style="{StaticResource HueCard}" Margin="0,0,12,12"
                    controls:HueBrushes.Hue="{Binding Hue}"
                    ToolTip="{Binding TooltipText}"
                    automation:AutomationProperties.HelpText="{Binding TooltipText}">
                <Grid>
                    <Border Style="{StaticResource HueWash}" controls:HueBrushes.Hue="{Binding Hue}"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource HueIconChip}" Width="24" Height="24" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource HueIconChipGlyph}"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ValueText}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{Binding (controls:HueBrushes.Brush), RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Secondary}"
                                   FontSize="12" Height="16" TextTrimming="CharacterEllipsis"/>
                        <controls:Sparkline Values="{Binding Values}" Maximum="{Binding Maximum}"
                                             Height="40" Margin="0,10,0,0" FillOpacity="0.24" ShowEndPoint="True"
                                             Stroke="{Binding (controls:HueBrushes.Brush), RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dashboard:DriveRowViewModel}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding IsLow, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="Low space" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <!-- Green / amber / red by how full the drive is; "Low space" above says it in words. -->
                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="8" Margin="0,4,0,4"
                             Minimum="0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FillLevel}" Value="Filling">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FillLevel}" Value="Low">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding DetailText}"
                           Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"/>
                <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Free up space"
                        Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Visibility="{Binding IsLow, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.FreeUpSpaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dashboard:ProcessRowViewModel}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <!-- Letter tile in a colour picked from the app's name, so each app keeps its colour. -->
                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" Margin="0,0,10,0"
                        controls:HueBrushes.Hue="{Binding Hue}"
                        Background="{Binding (controls:HueBrushes.Brush), RelativeSource={RelativeSource Self}}">
                    <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding NameText}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <!-- Memory relative to the hungriest app in the list. -->
                <ProgressBar Grid.Column="3" Width="32" Height="4" Margin="12,0,0,0" VerticalAlignment="Center"
                             Minimum="0" Maximum="1" Value="{Binding MemoryShare, Mode=OneWay}"
                             Foreground="{DynamicResource HueVioletBrush}" Focusable="False"
                             automation:AutomationProperties.Name="Memory compared with the other apps"/>
                <TextBlock Grid.Column="4" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dashboard:SystemInfoRowViewModel}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Secondary}"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,24">

            <!-- Header -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,6"
                        Visibility="{Binding IsRestartPending, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Restart pending" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Metric tiles -->
            <ItemsControl ItemsSource="{Binding MetricTiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Drives / Top processes -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Drives" Style="{StaticResource CardTitle}"/>
                        <ItemsControl ItemsSource="{Binding Drives}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Top processes" Style="{StaticResource CardTitle}"/>
                        <ItemsControl ItemsSource="{Binding TopProcesses}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="System" Style="{StaticResource CardTitle}"/>
                    <ItemsControl ItemsSource="{Binding SystemInfoRows}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
