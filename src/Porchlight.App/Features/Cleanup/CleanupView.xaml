<UserControl x:Class="Porchlight.App.Features.Cleanup.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Porchlight.App.Controls"
             xmlns:cleanup="clr-namespace:Porchlight.App.Features.Cleanup"
             d:DataContext="{d:DesignInstance cleanup:CleanupViewModel}"
             mc:Ignorable="d">
  <UserControl.Resources>

    <DataTemplate x:Key="CategoryRowTemplate" DataType="{x:Type cleanup:CleanupCategoryRowViewModel}">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}">
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                        Visibility="{Binding Note, Converter={StaticResource StringToVis}}">
              <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"
                         Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
              <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </CheckBox>
        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold"
                   VerticalAlignment="Top" Margin="12,0,0,0"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type cleanup:CleanupFileRowViewModel}">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Folder}" Style="{StaticResource Secondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
          <TextBlock Style="{StaticResource Secondary}" FontSize="12">
            <Run Text="{Binding SizeText, Mode=OneWay}"/>
            <Run Text=" - "/>
            <Run Text="{Binding ModifiedText, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="Show in folder" Margin="0,0,8,0"
                  Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"/>
          <Button Content="Move to Recycle Bin"
                  Command="{Binding DataContext.MoveToRecycleBinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type cleanup:CleanupAppRowViewModel}">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Publisher}" Style="{StaticResource Secondary}" FontSize="12"
                     Visibility="{Binding Publisher, Converter={StaticResource StringToVis}}"/>
          <TextBlock Style="{StaticResource Secondary}" FontSize="12">
            <Run Text="{Binding SizeText, Mode=OneWay}"/>
            <Run Text=" "/>
            <Run Text="{Binding InstalledText, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="1" Content="Uninstall..." VerticalAlignment="Center" Margin="12,0,0,0"
                Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}"
                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"/>
        <Button Grid.Column="1" Content="Open Installed apps" VerticalAlignment="Center" Margin="12,0,0,0"
                Visibility="{Binding CannotUninstall, Converter={StaticResource BoolToVis}}"
                Command="{Binding DataContext.OpenInstalledAppsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
      </Grid>
    </DataTemplate>

    <!-- One line of the disk map: icon + kind text (never colour alone), name, bar, size and share. -->
    <DataTemplate x:Key="DiskRowTemplate" DataType="{x:Type cleanup:DiskRowViewModel}">
      <Grid Margin="0,0,0,10" AutomationProperties.Name="{Binding AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding KindText, StringFormat=' ({0})'}" Style="{StaticResource Secondary}" FontSize="12"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <ProgressBar Height="6" Margin="0,4,0,2" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>
          <TextBlock Style="{StaticResource Secondary}" FontSize="12">
            <Run Text="{Binding SizeText, Mode=OneWay}"/>
            <Run Text=" - "/>
            <Run Text="{Binding PercentText, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="Open" Margin="0,0,8,0"
                  Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                  Command="{Binding DataContext.DiskMap.OpenRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"/>
          <Button Content="Show in folder" Margin="0,0,8,0"
                  Visibility="{Binding CanShowInFolder, Converter={StaticResource BoolToVis}}"
                  Command="{Binding DataContext.DiskMap.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"/>
          <Button Content="Move to Recycle Bin"
                  Visibility="{Binding CanRecycle, Converter={StaticResource BoolToVis}}"
                  Command="{Binding DataContext.DiskMap.MoveToRecycleBinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BreadcrumbTemplate" DataType="{x:Type cleanup:DiskBreadcrumbViewModel}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="6,0,6,0" VerticalAlignment="Center"
                   Visibility="{Binding IsFirst, Converter={StaticResource InverseBoolToVis}}"/>
        <TextBlock FontWeight="SemiBold" Visibility="{Binding IsLink, Converter={StaticResource BoolToVis}}">
          <Hyperlink Command="{Binding DataContext.DiskMap.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     CommandParameter="{Binding}"><Run Text="{Binding Label, Mode=OneWay}"/></Hyperlink>
        </TextBlock>
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DuplicateFileTemplate" DataType="{x:Type cleanup:DuplicateFileRowViewModel}">
      <Grid Margin="0,4,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanTick}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text=" - Newest" FontWeight="SemiBold"
                         Visibility="{Binding IsNewest, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Secondary}" FontSize="12"/>
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsLastCopy, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
              <TextBlock Text="This copy will stay" FontSize="12"/>
            </StackPanel>
          </StackPanel>
        </CheckBox>
        <Button Grid.Column="1" Content="Show in folder" VerticalAlignment="Center" Margin="12,0,0,0"
                Command="{Binding DataContext.Duplicates.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DuplicateGroupTemplate" DataType="{x:Type cleanup:DuplicateGroupViewModel}">
      <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding WastedText}" Style="{StaticResource Secondary}" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Keep newest" Command="{Binding KeepNewestCommand}"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource DuplicateFileTemplate}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="24">
      <TextBlock Text="Free up space" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="Clear out things your PC no longer needs. Your own files are never deleted without you choosing them."
                 Style="{StaticResource Secondary}" Margin="0,4,0,16" TextWrapping="Wrap"/>

      <controls:AdminRequiredBanner
          Message="Some cleanups need administrator rights. Restart as administrator to include them."
          Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}"/>

      <!-- Header: system drive and running total. -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <StackPanel DataContext="{Binding SystemDrive}">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
            <ProgressBar Height="6" Margin="0,6,0,4" Minimum="0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"/>
            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Secondary}" FontSize="12"/>
          </StackPanel>
          <TextBlock Text="{Binding FreedSoFarText}" Margin="0,8,0,0"
                     Visibility="{Binding FreedSoFarText, Converter={StaticResource StringToVis}}"/>
          <TextBlock Margin="0,8,0,0">
            <Hyperlink Command="{Binding OpenStorageSettingsCommand}">Open Windows Storage settings</Hyperlink>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Clean up card. -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Clean up" Style="{StaticResource CardTitle}" Margin="0"/>
            <Button Grid.Column="1" Content="Scan again" Command="{Binding ScanCommand}"/>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                      Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
            <TextBlock Text="Checking your PC. This can take a minute..." VerticalAlignment="Center"/>
          </StackPanel>
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12"
                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>

          <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryRowTemplate}"/>

          <TextBlock Text="{Binding SelectedTotalText}" FontWeight="SemiBold" Margin="0,4,0,8"
                     Visibility="{Binding SelectedTotalText, Converter={StaticResource StringToVis}}"/>

          <StackPanel Orientation="Horizontal">
            <Button Content="Clean up" Command="{Binding CleanCommand}"
                    Style="{DynamicResource AccentButtonStyle}" Padding="24,8"/>
            <Button Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0" Padding="16,8"
                    Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>

          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,4"
                       Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Secondary}"
                     Visibility="{Binding ProgressText, Converter={StaticResource StringToVis}}"/>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"
                      Visibility="{Binding ResultText, Converter={StaticResource StringToVis}}">
            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" MaxWidth="700"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- What's using space? (disk space map) -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel DataContext="{Binding DiskMap}">
          <TextBlock Text="What's using space?" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
          <TextBlock Text="See which folders and files take the most room on a drive or folder. This only looks - nothing is changed unless you choose it."
                     Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                      DisplayMemberPath="Label" MinWidth="200" Margin="0,0,8,0"
                      AutomationProperties.Name="Where to look"
                      IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"/>
            <Button Content="Choose a folder..." Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0"/>
            <Button Content="Scan" Command="{Binding ScanCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="20,6"/>
            <Button Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0" Padding="16,6"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>

          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4"
                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Secondary}" Margin="0,0,0,8"
                     Visibility="{Binding ProgressText, Converter={StaticResource StringToVis}}"/>

          <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}" ItemTemplate="{StaticResource BreadcrumbTemplate}" Margin="0,0,0,4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Secondary}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DiskRowTemplate}"/>
            <TextBlock Text="This folder is empty." Style="{StaticResource Secondary}"
                       Visibility="{Binding Rows.Count, Converter={StaticResource InverseCountToVis}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding CouldntReadText, Converter={StaticResource StringToVis}}">
              <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Top"/>
              <TextBlock Text="{Binding CouldntReadText}" TextWrapping="Wrap" MaxWidth="700" FontSize="12"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding Message, Converter={StaticResource StringToVis}}"/>
        </StackPanel>
      </Border>

      <!-- Duplicate files. -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel DataContext="{Binding Duplicates}">
          <TextBlock Text="Duplicate files" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
          <TextBlock Text="Finds identical copies of big files (1 MB or more) in your own folders. You choose which copies to move to the Recycle Bin, and one copy of each is always kept."
                     Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Find duplicates" Command="{Binding ScanCommand}"
                    Style="{DynamicResource AccentButtonStyle}" Padding="20,6"/>
            <Button Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0" Padding="16,6"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>

          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4"
                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Secondary}" Margin="0,0,0,8"
                     Visibility="{Binding ProgressText, Converter={StaticResource StringToVis}}"/>

          <StackPanel Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                        Visibility="{Binding Groups.Count, Converter={StaticResource CountToVis}}">
              <Button Content="Keep newest in every set" Command="{Binding KeepNewestInEveryGroupCommand}" Margin="0,0,8,0"/>
              <Button Content="Clear ticks" Command="{Binding ClearSelectionCommand}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource DuplicateGroupTemplate}"/>
            <TextBlock Text="{Binding SelectedText}" FontWeight="SemiBold" Margin="0,4,0,8"
                       Visibility="{Binding SelectedText, Converter={StaticResource StringToVis}}"/>
            <Button Content="Move ticked files to the Recycle Bin" Command="{Binding MoveSelectedCommand}"
                    HorizontalAlignment="Left" Padding="20,8"
                    Visibility="{Binding Groups.Count, Converter={StaticResource CountToVis}}"/>
          </StackPanel>

          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,4"
                       Visibility="{Binding IsRemoving, Converter={StaticResource BoolToVis}}"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                      Visibility="{Binding ResultText, Converter={StaticResource StringToVis}}">
            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" MaxWidth="700"/>
          </StackPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"
                     AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding Message, Converter={StaticResource StringToVis}}"/>
        </StackPanel>
      </Border>

      <!-- Big files. -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Big files" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
          <TextBlock Text="The largest files in your own folders. Nothing is removed unless you choose it, and removed files go to the Recycle Bin."
                     Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding BigFiles}" ItemTemplate="{StaticResource FileRowTemplate}"/>
          <TextBlock Text="No big files found." Style="{StaticResource Secondary}"
                     Visibility="{Binding BigFiles.Count, Converter={StaticResource InverseCountToVis}}"/>
          <TextBlock Text="{Binding FilesMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding FilesMessage, Converter={StaticResource StringToVis}}"/>
        </StackPanel>
      </Border>

      <!-- Old downloads. -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Old downloads" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
          <TextBlock Text="Installers and archives in Downloads that you have not touched for over 30 days."
                     Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding OldDownloads}" ItemTemplate="{StaticResource FileRowTemplate}"/>
          <TextBlock Text="Nothing to suggest." Style="{StaticResource Secondary}"
                     Visibility="{Binding OldDownloads.Count, Converter={StaticResource InverseCountToVis}}"/>
        </StackPanel>
      </Border>

      <!-- Large apps. -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Large apps" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
          <TextBlock Text="Programs that take the most room. Uninstalling opens the program's own uninstaller."
                     Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRowTemplate}"/>
          <TextBlock Text="No apps found." Style="{StaticResource Secondary}"
                     Visibility="{Binding Apps.Count, Converter={StaticResource InverseCountToVis}}"/>
          <Button Content="Show all" Command="{Binding ShowAllAppsCommand}" HorizontalAlignment="Left"
                  Visibility="{Binding CanShowAllApps, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding AppsMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding AppsMessage, Converter={StaticResource StringToVis}}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
