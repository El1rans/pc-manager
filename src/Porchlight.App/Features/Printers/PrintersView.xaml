<UserControl x:Class="Porchlight.App.Features.Printers.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Porchlight.App.Controls"
             xmlns:printers="clr-namespace:Porchlight.App.Features.Printers"
             d:DataContext="{d:DesignInstance printers:PrintersViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="PrinterRowTemplate" DataType="{x:Type printers:PrinterRowViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Default printer" Style="{StaticResource Secondary}"
                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding JobsText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding OfflineHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="170">
                        <Button Content="Use printer online" Margin="0,0,0,6"
                                Visibility="{Binding CanUseOnline, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.UseOnlineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding UseOnlineAutomationName}"/>
                        <Button Content="Make default" Margin="0,0,0,6" IsEnabled="{Binding CanMakeDefault}"
                                Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVis}}"
                                Command="{Binding DataContext.MakeDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding MakeDefaultAutomationName}"/>
                        <Button Content="Clear stuck print jobs" Margin="0,0,0,6" IsEnabled="{Binding CanClearJobs}"
                                Command="{Binding DataContext.ClearJobsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding ClearJobsAutomationName}"/>
                        <Button Content="Print a test page"
                                Command="{Binding DataContext.PrintTestPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding TestPageAutomationName}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Printers" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="My printer won't print" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Press Fix my printer to check the print service, clear stuck jobs and restart printing. You can also fix one thing at a time below."/>

            <controls:AdminRequiredBanner
                Message="Restarting the print service needs administrator rights. Restart as administrator to do that."
                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}"/>

            <WrapPanel Margin="0,0,0,12">
                <Button Content="Fix my printer" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,8"
                        IsEnabled="{Binding IsNotBusy}"
                        Command="{Binding FixMyPrinterCommand}"
                        AutomationProperties.Name="Fix my printer: check, clear and restart printing"/>
                <Button Content="Restart the print service" Margin="0,0,8,8"
                        IsEnabled="{Binding CanRestartService}"
                        Command="{Binding RestartServiceCommand}"
                        AutomationProperties.Name="Restart the print service"/>
                <Button Content="Open printer settings" Margin="0,0,8,8"
                        Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.Name="Open Windows printer settings"/>
                <Button Content="Refresh" Margin="0,0,8,8"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh the printer list"/>
            </WrapPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding HasFixSteps, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="What Porchlight did" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding FixSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type printers:FixStepRowViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding FixSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding FixSummary, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding Message, Converter={StaticResource StringToVis}}"/>
            <DockPanel Margin="0,0,0,12" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock Text="{Binding DefaultPrinterText}" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <TextBlock Text="No printers found. Add one in Windows' printer settings."
                       Style="{StaticResource Secondary}" TextWrapping="Wrap"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <ItemsControl ItemsSource="{Binding Printers}" ItemTemplate="{StaticResource PrinterRowTemplate}"/>

            <Expander Header="Other printers (PDF, XPS, OneNote, Fax)" Margin="0,8,0,0"
                      Visibility="{Binding HasOtherPrinters, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="Other printers that save files instead of printing on paper">
                <ItemsControl ItemsSource="{Binding OtherPrinters}" ItemTemplate="{StaticResource PrinterRowTemplate}" Margin="0,8,0,0"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
