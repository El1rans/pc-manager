<UserControl x:Class="Porchlight.App.Features.Lighting.LightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Porchlight.App.Controls"
             xmlns:lighting="clr-namespace:Porchlight.App.Features.Lighting"
             d:DataContext="{d:DesignInstance lighting:LightingViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <DockPanel>
                <TextBlock Text="Lighting" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>
            </DockPanel>

            <DockPanel Margin="0,4,0,4">
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Text" Value="&#xE783;"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Text" Value="&#xE73E;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ConnectionStatusText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock Text="{Binding LastActionMessage}" Style="{StaticResource Secondary}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Visibility="{Binding LastActionMessage, Converter={StaticResource StringToVis}}"/>

            <!-- Lighting conflict warning: other software that can also claim a device's RGB -
                 shown regardless of OpenRGB's own connection state (see docs/specs/05-lighting.md
                 addendum). Dismissible for this app session only. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    Visibility="{Binding ShowConflicts, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock DockPanel.Dock="Right" Text="Dismiss" Style="{StaticResource Secondary}"
                                   Cursor="Hand" VerticalAlignment="Top">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding DismissConflictsCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="Other software may also control this lighting" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,6">
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                    <Button Content="{Binding ActionLabel}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                            Command="{Binding DataContext.OpenConflictActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding ActionUri, Converter={StaticResource StringToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Setup card: shown until the openrgb component is installed and running. -->
            <StackPanel Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}">
                <controls:ComponentCard DataContext="{Binding OpenRgbCard}" Margin="0,0,0,16"/>
                <CheckBox Content="Start OpenRGB with Porchlight"
                          IsChecked="{Binding AutoStartOpenRgb, Mode=TwoWay}"
                          Margin="0,0,0,12"/>
                <Button Content="Retry connection" Command="{Binding RetryCommand}"
                        HorizontalAlignment="Left" Margin="0,0,0,16"
                        ToolTip="Recheck whether OpenRGB is installed and running"/>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowSetup, Converter={StaticResource InverseBoolToVis}}">

                <!-- All devices -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="All devices" Style="{StaticResource CardTitle}"/>

                        <ItemsControl ItemsSource="{x:Static lighting:LightingViewModel.PresetSwatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="28" Height="28" Margin="0,0,6,6" Padding="0"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.SelectSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding StringFormat='Apply {0} to all devices'}"
                                            AutomationProperties.Name="{Binding StringFormat='Swatch {0}'}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:ColorWheelPicker x:Name="AllDevicesColorPicker" Margin="0,8,0,0"
                                                    SelectedColorHex="{Binding SelectedColorHex, Mode=TwoWay}"/>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Brightness" Style="{StaticResource Secondary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BrightnessPercent, StringFormat={}{0:F0}%}"
                                       Style="{StaticResource Secondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding BrightnessPercent}" VerticalAlignment="Center"
                                    AutomationProperties.Name="Brightness"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Apply to all" Command="{Binding ApplyToAllCommand}" Margin="0,0,8,0"/>
                            <Button Content="Turn off all" Command="{Binding TurnOffAllCommand}" Margin="0,0,8,0"/>
                            <Button Content="Save as favorite" Command="{Binding SaveFavoriteCommand}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding FavoriteColors}" Margin="0,12,0,0"
                                      Visibility="{Binding FavoriteColors.Count, Converter={StaticResource CountToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,10,10">
                                        <Button Width="28" Height="28" Padding="0"
                                                Background="{Binding Converter={StaticResource HexToBrush}}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                Command="{Binding DataContext.SelectSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding StringFormat='Apply favorite {0} to all devices'}"
                                                AutomationProperties.Name="{Binding StringFormat='Favorite {0}'}"/>
                                        <Button Width="18" Height="18" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-8,-8,0"
                                                Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove favorite"
                                                AutomationProperties.Name="{Binding StringFormat='Remove favorite {0}'}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Device list -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Devices" Style="{StaticResource CardTitle}"/>
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" Style="{StaticResource Icon}"
                                                   FontSize="18" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding Modes}"
                                                  SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                                  Margin="8,0" IsEnabled="{Binding IsExcluded, Converter={StaticResource InverseBool}}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Mode for {0}'}"/>
                                        <Button Grid.Column="3" Width="26" Height="26" Padding="0" Margin="0,0,6,0"
                                                Command="{Binding SetColorCommand}"
                                                ToolTip="Set this device to the color above"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Set {0} to selected color'}"
                                                Background="{Binding DataContext.SelectedColorHex,
                                                    RelativeSource={RelativeSource AncestorType=lighting:LightingView},
                                                    Converter={StaticResource HexToBrush}}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>

                                        <ToggleButton Grid.Column="4" Content="&#xE790;" Width="26" Height="26" Padding="0"
                                                      FontFamily="{StaticResource IconFont}"
                                                      IsChecked="{Binding IsPickerOpen, Mode=TwoWay}"
                                                      ToolTip="Choose a color for this device"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='Choose a color for {0}'}"
                                                      Margin="0,0,6,0"/>

                                        <Popup PlacementTarget="{Binding RelativeSource={RelativeSource Self}}"
                                               IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="False"
                                               Placement="Bottom" AllowsTransparency="True">
                                            <Border Style="{StaticResource Card}" Margin="4">
                                                <StackPanel>
                                                    <controls:ColorWheelPicker Loaded="DeviceColorPicker_Loaded"
                                                                                SelectedColorHex="{Binding PickerColorHex, Mode=TwoWay}"/>
                                                    <Button Content="Close" HorizontalAlignment="Right" Margin="0,10,0,0"
                                                            Command="{Binding TogglePickerCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>

                                        <CheckBox Grid.Column="5" Content="Don't control"
                                                  IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="6,0,0,0"
                                                  ToolTip="Leave this device to its own vendor software (e.g. G HUB) instead of Porchlight/OpenRGB"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Do not control {0} from Porchlight'}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No devices found." Style="{StaticResource Secondary}"
                                   Visibility="{Binding Devices.Count, Converter={StaticResource InverseCountToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- LED effects (see docs/specs/11-led-effects.md) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding PauseEffectsButtonLabel}"
                                    Command="{Binding ToggleEffectsPausedCommand}"
                                    AutomationProperties.Name="{Binding PauseEffectsButtonLabel}"
                                    ToolTip="Pause or resume every device's custom LED effect"/>
                            <TextBlock Text="Effects" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <TextBlock Text="Custom effects run while Porchlight is open."
                                   Style="{StaticResource Secondary}" Margin="0,2,0,10"/>

                        <CheckBox Content="Updates alert overlay"
                                  IsChecked="{Binding UpdatesAlertOverlayEnabled, Mode=TwoWay}"
                                  Margin="0,0,0,14"
                                  ToolTip="Pulses a warning color over each device's effect while app updates are pending"
                                  AutomationProperties.Name="Updates alert overlay"/>

                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16"
                                                Visibility="{Binding IsExcluded, Converter={StaticResource InverseBoolToVis}}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}"
                                                       Style="{StaticResource Icon}" FontSize="16"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}"
                                                       VerticalAlignment="Center" MinWidth="150" Margin="0,0,10,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ComboBox ItemsSource="{Binding AvailableEffects}"
                                                      SelectedItem="{Binding SelectedEffectName, Mode=TwoWay}"
                                                      Width="190" HorizontalAlignment="Left"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='Effect for {0}'}"/>
                                        </DockPanel>

                                        <StackPanel Margin="26,8,0,0"
                                                    Visibility="{Binding ShowEffectSettings, Converter={StaticResource BoolToVis}}">
                                            <DockPanel Margin="0,0,0,8"
                                                       Visibility="{Binding ShowSpeedSetting, Converter={StaticResource BoolToVis}}">
                                                <TextBlock DockPanel.Dock="Left" Text="Speed" Width="70"
                                                           Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                                                <Slider Minimum="0.25" Maximum="3" Value="{Binding EffectSpeed}"
                                                        Width="220" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Effect speed for {0}'}"/>
                                            </DockPanel>

                                            <StackPanel Margin="0,0,0,8"
                                                        Visibility="{Binding ShowColorSetting, Converter={StaticResource BoolToVis}}">
                                                <controls:ColorWheelPicker SelectedColorHex="{Binding EffectColorHex, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <DockPanel Visibility="{Binding ShowTemperatureRangeSetting, Converter={StaticResource BoolToVis}}">
                                                <TextBlock DockPanel.Dock="Left" Text="Min &#176;C" Width="70"
                                                           Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                                                <TextBox DockPanel.Dock="Left" Width="60" Margin="0,0,20,0"
                                                         Text="{Binding EffectMinTempC, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="{Binding Name, StringFormat='Minimum temperature for {0}'}"/>
                                                <TextBlock DockPanel.Dock="Left" Text="Max &#176;C" Width="70"
                                                           Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                                                <TextBox Width="60"
                                                         Text="{Binding EffectMaxTempC, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="{Binding Name, StringFormat='Maximum temperature for {0}'}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No devices found." Style="{StaticResource Secondary}"
                                   Visibility="{Binding Devices.Count, Converter={StaticResource InverseCountToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Profiles -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Profiles" Style="{StaticResource CardTitle}"/>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Load"
                                                Command="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding StringFormat='Load profile {0}'}"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No saved profiles." Style="{StaticResource Secondary}"
                                   Visibility="{Binding Profiles.Count, Converter={StaticResource InverseCountToVis}}"/>
                    </StackPanel>
                </Border>

                <CheckBox Content="Start OpenRGB with Porchlight"
                          IsChecked="{Binding AutoStartOpenRgb, Mode=TwoWay}"
                          Margin="0,0,0,16"/>

                <Button Content="Retry connection" Command="{Binding RetryCommand}"
                        HorizontalAlignment="Left" Margin="0,0,0,16"
                        Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
