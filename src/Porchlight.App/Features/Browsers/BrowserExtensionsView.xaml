<UserControl x:Class="Porchlight.App.Features.Browsers.BrowserExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="clr-namespace:Porchlight.App.Features.Browsers"
             xmlns:core="clr-namespace:Porchlight.Core.Browsers;assembly=Porchlight.Core"
             d:DataContext="{d:DesignInstance b:BrowserExtensionsViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="24">
            <TextBlock Text="Browser add-ons" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Summary}" Margin="0,4,0,4" TextWrapping="Wrap" FontSize="16"/>
            <TextBlock Text="Porchlight only looks. It never changes, turns off or removes anything in your browsers."
                       Style="{StaticResource Secondary}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,16,0"/>
                <CheckBox Content="Show only add-ons to review" IsChecked="{Binding ShowOnlyReview}"/>
            </StackPanel>

            <Border Padding="12" CornerRadius="6" Margin="0,0,0,12"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="1"
                    Visibility="{Binding OpenMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding OpenMessage}" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="No browser add-ons found." Style="{StaticResource Secondary}" Margin="0,0,0,12"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type b:BrowserSectionViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" Margin="0"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{Binding OpenButtonText}" Command="{Binding OpenCommand}"/>
                                </Grid>

                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Secondary}"
                                           Visibility="{Binding ShowEmptyText, Converter={StaticResource BoolToVis}}"/>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type b:ExtensionItemViewModel}">
                                            <StackPanel Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding LevelGlyph}" FontSize="16" Margin="0,0,6,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static core:ExtensionRiskLevel.Review}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static core:ExtensionRiskLevel.WorthRemoving}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"/>
                                                <ItemsControl ItemsSource="{Binding Flags}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type core:ExtensionRiskFlag}">
                                                            <StackPanel Margin="12,0,0,4">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Explanation}"
                                                                           Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="How to remove an add-on" Style="{StaticResource CardTitle}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="15"
                               Text="1. Click &quot;Open ... add-ons page&quot; next to your browser above.&#10;2. Find the add-on in the list.&#10;3. Click Remove (in Firefox, click the three dots next to it, then Remove) and confirm.&#10;If you are not sure whether to remove one, ask the family member who looks after your PC."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
