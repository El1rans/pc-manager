<UserControl x:Class="Porchlight.App.Features.Startup.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Porchlight.App.Controls"
             xmlns:startup="clr-namespace:Porchlight.App.Features.Startup"
             d:DataContext="{d:DesignInstance startup:StartupViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Startup apps" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Text="These programs start by themselves when you sign in to Windows. Turning one off doesn't remove it, and you can turn it back on here at any time."/>

            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh the startup list"/>
                <CheckBox DockPanel.Dock="Right" Content="Sort by impact" IsChecked="{Binding SortByImpact}" Margin="0,0,16,0"
                          AutomationProperties.Name="Sort the startup list by impact"/>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>

            <controls:AdminRequiredBanner
                Message="Some items are for all users on this PC. Restart as administrator to change them."
                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}"/>

            <DockPanel Margin="0,0,0,12" Visibility="{Binding ShowImpactHint, Converter={StaticResource BoolToVis}}">
                <Button DockPanel.Dock="Right" Content="Restart as administrator" Margin="12,0,0,0" Click="OnRestartAsAdminClick"
                        AutomationProperties.Name="Restart Porchlight as administrator to see startup impact"/>
                <TextBlock Text="Run Porchlight as administrator to see startup impact." TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding Message, Converter={StaticResource StringToVis}}"/>
            <DockPanel Margin="0,0,0,12" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock Text="Nothing starts automatically. Your PC should start quickly." Style="{StaticResource Secondary}"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type startup:StartupEntryViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap">
                                        <Run Text="{Binding Publisher, Mode=OneWay}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding SourceLabel, Mode=OneWay}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding ImpactGlyph}" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding ImpactText}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                Visibility="{Binding RecommendedToKeep, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                        <TextBlock Text="Recommended to keep"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="120">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Content="{Binding ToggleLabel}" IsEnabled="{Binding CanChange}"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding ToggleAutomationName}"/>
                                    <TextBlock Text="Needs administrator" Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                               Visibility="{Binding ShowNeedsAdmin, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
