<UserControl x:Class="Porchlight.App.Features.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:Porchlight.App.Features.Settings"
             d:DataContext="{d:DesignInstance settings:GeneralSettingsViewModel}"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,16,16">
      <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,16" TextWrapping="Wrap"
                 Text="How Porchlight looks and how it starts. Changes apply straight away."/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="Theme" Margin="0,0,0,4"/>
          <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                    DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="160"
                    AutomationProperties.Name="Theme"/>
        </StackPanel>
      </Border>

      <settings:TextSizeCard Margin="0,0,0,12"/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="When I sign in" Style="{StaticResource CardTitle}"/>
          <CheckBox Content="Start Porchlight when I sign in to Windows"
                    IsChecked="{Binding StartAtLogin}" IsEnabled="{Binding CanChangeStartAtLogin}"
                    AutomationProperties.Name="Start Porchlight when I sign in to Windows"/>
          <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Starts in the tray, as administrator, so every sensor works. Turning this on or off asks for admin permission once."/>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     Text="{Binding StartAtLoginError}"
                     Visibility="{Binding HasStartAtLoginError, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="When I close the window" Style="{StaticResource CardTitle}"/>
          <CheckBox Content="Keep Porchlight running in the tray when I close the window"
                    IsChecked="{Binding KeepRunningInTray}"
                    AutomationProperties.Name="Keep Porchlight running in the tray when I close the window"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Before big changes" Style="{StaticResource CardTitle}"/>
          <CheckBox Content="Create a restore point before big changes"
                    IsChecked="{Binding CreateRestorePointBeforeBigChanges}"
                    AutomationProperties.Name="Create a restore point before big changes"/>
          <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Before updating several apps or changing a service, Porchlight asks Windows for a restore point if System Protection is on. It never stops the change if Windows says no."/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
