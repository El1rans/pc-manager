<UserControl x:Class="Porchlight.App.Features.Health.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Porchlight.App.Controls"
             xmlns:health="clr-namespace:Porchlight.App.Features.Health"
             d:DataContext="{d:DesignInstance health:HealthViewModel}"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650">
  <UserControl.Resources>
    <!-- Status is never colour alone: every icon sits next to a text label. -->
    <Style x:Key="SeverityIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Ok">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Problem">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResultIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding ResultSeverity}" Value="Ok">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding ResultSeverity}" Value="Warning">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="24">
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="Check again" Command="{Binding RefreshCommand}"
                VerticalAlignment="Center"/>
        <StackPanel>
          <TextBlock Text="Health check" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="See if your PC is in good shape, and fix common problems."
                     Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>

      <controls:AdminRequiredBanner
          Message="Repairing Windows and creating restore points need administrator rights. The other checks work without it."
          Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}"/>

      <!-- Disk health -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel DataContext="{Binding Disks}">
          <TextBlock Text="Disk health" Style="{StaticResource CardTitle}"/>
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                       Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}"
                     Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding PredictWarning}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"
                     Foreground="{DynamicResource SystemFillColorCautionBrush}"
                     Visibility="{Binding PredictWarning, Converter={StaticResource StringToVis}}"/>
          <ItemsControl ItemsSource="{Binding Disks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Glyph}" Style="{StaticResource SeverityIcon}"
                             VerticalAlignment="Top"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding VerdictText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ReasonsText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                               Visibility="{Binding HasReasons, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Windows repair -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel DataContext="{Binding Repair}">
          <TextBlock Text="Windows repair" Style="{StaticResource CardTitle}"/>
          <TextBlock TextWrapping="Wrap"
                     Text="Checks Windows' own files for damage and repairs them. Try this if Windows is slow, crashes, or acts strangely."/>
          <TextBlock Text="{Binding Warning}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,10"/>
          <WrapPanel>
            <Button Content="Check and repair Windows files" Command="{Binding StartCheckCommand}"
                    Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Run deeper repair" Command="{Binding RunDeeperRepairCommand}"
                    Visibility="{Binding DeeperRepairOffered, Converter={StaticResource BoolToVis}}"/>
          </WrapPanel>
          <StackPanel Margin="0,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate}"/>
            <TextBlock Text="{Binding StepText}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                      Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ResultGlyph}" Style="{StaticResource ResultIcon}" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" MaxWidth="700" VerticalAlignment="Center"/>
          </StackPanel>
          <Expander Header="Details" Margin="0,8,0,0">
            <TextBox Text="{Binding LogText, Mode=OneWay}" Height="140" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
          </Expander>
        </StackPanel>
      </Border>

      <!-- Restore point -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel DataContext="{Binding RestorePoint}">
          <TextBlock Text="Restore point" Style="{StaticResource CardTitle}"/>
          <TextBlock TextWrapping="Wrap"
                     Text="A restore point is a safety snapshot of Windows. If a change goes wrong, Windows can go back to it. Your own files aren't touched."/>
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                       Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" Margin="0,8,0,4"
                     Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding AvailabilityText}" TextWrapping="Wrap" Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Visibility="{Binding AvailabilityText, Converter={StaticResource StringToVis}}"/>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="Create a restore point" Command="{Binding CreateCommand}"
                    Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Open System Protection" Command="{Binding OpenSystemProtectionCommand}"/>
          </WrapPanel>
          <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="Most recent restore points" FontWeight="SemiBold" Margin="0,14,0,4"/>
          <TextBlock Text="{Binding RecentNote}" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                     Visibility="{Binding RecentNote, Converter={StaticResource StringToVis}}"/>
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding WhenText}" Style="{StaticResource Secondary}"
                             Margin="12,0,0,0"/>
                  <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Backup -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel DataContext="{Binding Backup}">
          <TextBlock Text="Backup" Style="{StaticResource CardTitle}"/>
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                       Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}"
                     Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}"/>
          <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Glyph}" Style="{StaticResource SeverityIcon}" VerticalAlignment="Top"/>
              <TextBlock Text="{Binding HeadlineText}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="700"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding DetailLines}" Margin="28,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Secondary}" TextWrapping="Wrap" MaxWidth="700"
                             Margin="0,0,0,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding OtherToolsText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                       MaxWidth="700" Margin="28,2,0,0"
                       Visibility="{Binding OtherToolsText, Converter={StaticResource StringToVis}}"/>
            <TextBlock Text="{Binding NudgeText}" TextWrapping="Wrap" MaxWidth="700" Margin="28,10,0,0"
                       Visibility="{Binding NudgeText, Converter={StaticResource StringToVis}}"/>
          </StackPanel>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="Turn on File History" Command="{Binding TurnOnFileHistoryCommand}"
                    AutomationProperties.Name="Turn on File History"
                    Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"
                    Visibility="{Binding CanTurnOnFileHistory, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Open backup settings" Command="{Binding OpenBackupSettingsCommand}"
                    AutomationProperties.Name="Open backup settings" Margin="0,0,8,0"/>
            <Button Content="Open OneDrive" Command="{Binding OpenOneDriveCommand}"
                    AutomationProperties.Name="Open OneDrive"
                    Visibility="{Binding CanOpenOneDrive, Converter={StaticResource BoolToVis}}"/>
          </WrapPanel>
          <TextBlock Text="{Binding LaunchError}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                     Visibility="{Binding LaunchError, Converter={StaticResource StringToVis}}"/>
        </StackPanel>
      </Border>

      <!-- Recent problems -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel DataContext="{Binding Problems}">
          <TextBlock Text="Recent problems" Style="{StaticResource CardTitle}"/>
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                       Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}"
                     Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}"/>
          <StackPanel Orientation="Horizontal" Visibility="{Binding ShowNoProblems, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"
                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
            <TextBlock Text="{Binding NoProblemsText}" VerticalAlignment="Center"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Problems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding LastText}" Style="{StaticResource Secondary}"/>
                  <TextBlock Text="{Binding Advice}" TextWrapping="Wrap"
                             Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Battery (laptops only) -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"
              Visibility="{Binding Battery.IsVisible, Converter={StaticResource BoolToVis}}">
        <StackPanel DataContext="{Binding Battery}">
          <TextBlock Text="Battery" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}"
                     Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}"/>
          <StackPanel Orientation="Horizontal" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource SeverityIcon}" VerticalAlignment="Top"/>
            <StackPanel>
              <TextBlock Text="{Binding VerdictText}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="700"/>
              <TextBlock Text="{Binding DetailText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                         MaxWidth="700"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
