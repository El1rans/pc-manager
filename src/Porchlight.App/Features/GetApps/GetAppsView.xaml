<UserControl x:Class="Porchlight.App.Features.GetApps.GetAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:getapps="clr-namespace:Porchlight.App.Features.GetApps"
             d:DataContext="{d:DesignInstance getapps:GetAppsViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type getapps:AppResultViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap">
                            <Run Text="{Binding Id, Mode=OneWay}"/>
                            <Run Text="{Binding VersionText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Margin="0,4,0,0" MaxHeight="40"
                                   Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding ShowResultText, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Margin="0,0,6,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding ResultIsError, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" MaxWidth="560"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="110">
                        <Button Content="Install" Command="{Binding InstallCommand}" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{Binding InstallAutomationName}"
                                Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="40" Height="4" Margin="0,0,8,0" BorderThickness="0"/>
                            <TextBlock Text="Installing..."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,6,0"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="Installed" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Get apps" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="Find an app and install it safely from the official winget catalog, without searching the web for a download."/>

            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0"
                        MinWidth="90" AutomationProperties.Name="Search for apps"/>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search for an app">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Search for an app, e.g. VLC"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Resources>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                        Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}">
                <ProgressBar IsIndeterminate="True" Width="60" Height="4" Margin="0,0,10,0" BorderThickness="0"
                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
            </StackPanel>

            <DockPanel Margin="0,0,0,12" Visibility="{Binding ErrorText, Converter={StaticResource StringToVis}}">
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock Text="Popular apps" FontWeight="SemiBold" Margin="0,4,0,8"
                       Visibility="{Binding ShowPopular, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding PopularApps}" ItemTemplate="{StaticResource AppRowTemplate}"
                          Visibility="{Binding ShowPopular, Converter={StaticResource BoolToVis}}"/>

            <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource AppRowTemplate}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
