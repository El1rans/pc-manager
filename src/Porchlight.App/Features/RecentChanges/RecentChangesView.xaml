<UserControl x:Class="Porchlight.App.Features.RecentChanges.RecentChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:changes="clr-namespace:Porchlight.App.Features.RecentChanges"
             d:DataContext="{d:DesignInstance changes:RecentChangesViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Recent changes" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="Here is what Porchlight has changed on this PC, newest first. Where it's possible, you can undo a change."/>

            <DockPanel Margin="0,0,0,12" Visibility="{Binding Message, Converter={StaticResource StringToVis}}">
                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,12" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock Text="Nothing yet. When Porchlight changes something, it will show up here."
                       Style="{StaticResource Secondary}"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <ItemsControl ItemsSource="{Binding Changes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type changes:RecentChangeRowViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap">
                                        <Run Text="{Binding AreaText, Mode=OneWay}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding TimeText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="120">
                                    <Button Content="Undo" IsEnabled="{Binding CanUndo}"
                                            Visibility="{Binding ShowCannotUndo, Converter={StaticResource InverseBoolToVis}}"
                                            Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding UndoAutomationName}"/>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowCannotUndo, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Can't be undone" Style="{StaticResource Secondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                Visibility="{Binding ShowUndone, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Undone"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
