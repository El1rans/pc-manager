<UserControl x:Class="Porchlight.App.Features.Hardware.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Porchlight.App.Controls"
             xmlns:local="clr-namespace:Porchlight.App.Features.Hardware"
             mc:Ignorable="d">
    <UserControl.Resources>
        <local:FanModeVisibilityConverter x:Key="FanModeToVisibility"/>

        <!-- S10: one fixed set of column widths shared by the header row and every sensor row, in
             every card, so Name/Current/Min/Max line up across the whole page (spec 10: "Columns
             align across every card"). -->
        <GridLength x:Key="SensorNameColumnWidth">*</GridLength>
        <GridLength x:Key="SensorValueColumnWidth">92</GridLength>

        <!-- Current/Name are the primary, most prominent text on a sensor row; Min/Max use the
             secondary brush. This is the fix for "Inverted emphasis" - nothing here inherits a
             dimmed foreground from a TreeViewItem container the way the old tree-based layout did. -->
        <Style x:Key="SensorColumnHeaderText" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="SensorNameText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SensorCurrentText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SensorMinMaxText" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryWarningIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type local:SensorRowViewModel}">
            <Grid Margin="0,2" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource SensorNameColumnWidth}"/>
                    <ColumnDefinition Width="{StaticResource SensorValueColumnWidth}"/>
                    <ColumnDefinition Width="{StaticResource SensorValueColumnWidth}"/>
                    <ColumnDefinition Width="{StaticResource SensorValueColumnWidth}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource SensorNameText}"/>
                <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource SensorCurrentText}"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock Grid.Column="2" Text="{Binding MinText}" Style="{StaticResource SensorMinMaxText}"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock Grid.Column="3" Text="{Binding MaxText}" Style="{StaticResource SensorMinMaxText}"
                           Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SensorSectionViewModel}">
            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Heading}" Style="{StaticResource Secondary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Sensors}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:HardwareCardViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" Margin="0"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <!-- One column header row per card, not per section (spec 10). -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource SensorNameColumnWidth}"/>
                                <ColumnDefinition Width="{StaticResource SensorValueColumnWidth}"/>
                                <ColumnDefinition Width="{StaticResource SensorValueColumnWidth}"/>
                                <ColumnDefinition Width="{StaticResource SensorValueColumnWidth}"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Current" Style="{StaticResource SensorColumnHeaderText}"/>
                            <TextBlock Grid.Column="2" Text="Min" Style="{StaticResource SensorColumnHeaderText}"/>
                            <TextBlock Grid.Column="3" Text="Max" Style="{StaticResource SensorColumnHeaderText}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Sections}"/>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:HardwareSummaryTileViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ValueText}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Secondary}"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding IsWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding WarningIcon}" Style="{StaticResource SummaryWarningIcon}" FontSize="13"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding WarningText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Hardware" Style="{StaticResource PageTitle}"/>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <controls:AdminRequiredBanner
                Message="Sign in as administrator to see every sensor and control fans."
                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}"/>

            <controls:ComponentCard DataContext="{Binding PawnIoCard}"
                                     Visibility="{Binding DataContext.ShowDriverCard, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                     Margin="0,0,0,16"/>

            <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding CriticalMessage, Converter={StaticResource StringToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE783;" Style="{StaticResource Icon}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding CriticalMessage}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="0,4,0,0">
            <TabItem Header="Sensors">
                <DockPanel Margin="0,12,0,0">
                    <!-- Summary strip: "At a glance" (spec 10) - up to 4 tiles, hidden entirely when
                         nothing was found yet (e.g. still starting up, or not elevated). -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SummaryTiles}"
                                  Visibility="{Binding SummaryTiles.Count, Converter={StaticResource CountToVis}}"
                                  Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <DockPanel DockPanel.Dock="Top" Margin="0,8,0,10">
                        <Button DockPanel.Dock="Right" Content="Reset min/max" Command="{Binding ResetMinMaxCommand}" Margin="10,0,0,0"/>
                        <CheckBox DockPanel.Dock="Right" Content="Hide unused sensors" VerticalAlignment="Center"
                                  Margin="16,0,0,0" IsChecked="{Binding HideUnusedSensors}"/>
                        <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter by hardware or sensor name"/>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Cards}"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Fans">
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Global fan control" Style="{StaticResource CardTitle}"/>
                            <CheckBox Content="Software fan control" IsChecked="{Binding SoftwareFanControlEnabled}"
                                      IsEnabled="{Binding CanToggleSoftwareFanControl}"/>
                            <TextBlock Text="{Binding SoftwareFanControlDisabledReason}" Style="{StaticResource Secondary}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding CanToggleSoftwareFanControl, Converter={StaticResource InverseBoolToVis}}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Overheat failsafe temperature (C)" Style="{StaticResource Secondary}"/>
                                    <Slider Minimum="70" Maximum="95" Value="{Binding FailsafeTemperatureC}"
                                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding FailsafeTemperatureC, StringFormat={}{0:0} C}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Minimum fan percent" Style="{StaticResource Secondary}"/>
                                    <Slider Minimum="20" Maximum="100" Value="{Binding MinFanPercent}"
                                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding MinFanPercent, StringFormat={}{0}%}"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="Restore BIOS control for all fans" Command="{Binding RestoreAllFansCommand}"
                                    Margin="0,12,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="This PC doesn't expose fan controls to Windows."
                               Style="{StaticResource Secondary}" Margin="0,0,0,12"
                               Visibility="{Binding ShowNoControllableFansMessage, Converter={StaticResource BoolToVis}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Fans}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:FanCardViewModel}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" Margin="0"/>
                                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                    <Run Text="{Binding CurrentRpm, StringFormat={}{0:0} RPM, Mode=OneWay}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding CurrentPercent, StringFormat={}{0:0}%, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>

                                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Margin="0,8,0,0" HorizontalAlignment="Left" MinWidth="120"
                                                      IsEnabled="{Binding CanEditMode}"
                                                      ToolTip="{Binding ModeEditDisabledReason}"/>

                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding Mode, Converter={StaticResource FanModeToVisibility}, ConverterParameter=Fixed}">
                                                <TextBlock Text="Fixed percent" Style="{StaticResource Secondary}"/>
                                                <Slider Minimum="{Binding MinFanPercent}" Maximum="100"
                                                        Value="{Binding FixedPercent}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                <TextBlock Text="{Binding FixedPercent, StringFormat={}{0:0}%}"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding Mode, Converter={StaticResource FanModeToVisibility}, ConverterParameter=Curve}">
                                                <TextBlock Text="Source temperature sensor" Style="{StaticResource Secondary}"/>
                                                <ComboBox ItemsSource="{Binding TemperatureSensorOptions}"
                                                          SelectedValue="{Binding SourceSensorId}" SelectedValuePath="Id"
                                                          DisplayMemberPath="Name" HorizontalAlignment="Left" MinWidth="220"/>
                                                <local:FanCurveEditor Points="{Binding CurvePoints}" MinPercent="{Binding MinFanPercent}"
                                                                      CommitCommand="{Binding CommitCurveCommand}"
                                                                      Height="160" Margin="0,10,0,0"/>
                                                <DockPanel Margin="0,6,0,0">
                                                    <Button DockPanel.Dock="Left" Content="Add point" Command="{Binding AddCurvePointCommand}"/>
                                                    <TextBlock Text="{Binding CurveError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                               Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
