<Window x:Class="Porchlight.App.Features.Notifications.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:n="clr-namespace:Porchlight.App.Features.Notifications"
        d:DataContext="{d:DesignInstance n:NotificationsViewModel}"
        mc:Ignorable="d"
        Title="Notifications" Height="520" Width="520" MinHeight="440" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Icon="/Assets/porchlight.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Notifications" Style="{StaticResource PageTitle}" FontSize="20"/>
      <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,16" TextWrapping="Wrap"
                 Text="Porchlight can stay in the corner of your screen and tell you when something needs attention. It never installs anything by itself."/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="Theme" Margin="0,0,0,4"/>
          <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                    DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="160"
                    AutomationProperties.Name="Theme"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="When I close the window" Style="{StaticResource CardTitle}"/>
          <CheckBox Content="Keep Porchlight running in the tray when I close the window"
                    IsChecked="{Binding KeepRunningInTray}"
                    AutomationProperties.Name="Keep Porchlight running in the tray when I close the window"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Tell me when" Style="{StaticResource CardTitle}"/>
          <CheckBox Content="A drive is almost full" IsChecked="{Binding AlertLowDisk}" Margin="0,0,0,8"/>
          <CheckBox Content="My PC is running too hot" IsChecked="{Binding AlertTemperature}" Margin="0,0,0,8"/>
          <CheckBox Content="App updates are ready" IsChecked="{Binding AlertUpdates}" Margin="0,0,0,8"/>
          <CheckBox Content="My PC has needed a restart for a few days" IsChecked="{Binding AlertRestartPending}"/>
          <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Each message is shown at most once a day. Temperature messages need Porchlight to run as administrator with the hardware driver installed."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Check for app updates" Style="{StaticResource CardTitle}"/>
          <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding SelectedSchedule}"
                    DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="160"
                    AutomationProperties.Name="How often to check for app updates"/>
          <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Porchlight only looks for updates. You choose when to install them."/>
        </StackPanel>
      </Border>

      <Button Content="Close" Click="CloseButton_Click" IsDefault="True" IsCancel="True"
              HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="88"/>
    </StackPanel>
  </ScrollViewer>
</Window>
