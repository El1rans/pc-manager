<UserControl x:Class="Porchlight.App.Features.RemoveApps.RemoveAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Porchlight.App.Features.RemoveApps"
             d:DataContext="{d:DesignInstance local:RemoveAppsViewModel}"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600">

    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:AppRowViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12,8"
                    AutomationProperties.Name="{Binding RowAutomationName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Publisher}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Publisher, Converter={StaticResource StringToVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding IsOftenPreinstalled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="Often preinstalled" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding SizeText}" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding InstalledText}" Style="{StaticResource Secondary}"
                                   Visibility="{Binding InstalledText, Converter={StaticResource StringToVis}}"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="Remove" IsEnabled="{Binding CanRemoveNow}"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding RemoveAutomationName}"/>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsManaged, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="Managed by Porchlight" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,12,0">
            <TextBlock Text="Remove apps" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Text="Programs installed on this PC. Porchlight asks before it removes anything. Things Windows or your other apps need are kept in a separate group at the bottom."/>

            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh the list of apps"/>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>

            <DockPanel Margin="0,0,0,12" LastChildFill="True">
                <ComboBox DockPanel.Dock="Right" Width="160" Margin="12,0,0,0"
                          ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Sort" SelectedValue="{Binding SelectedSort}"
                          AutomationProperties.Name="Sort by"/>
                <TextBlock DockPanel.Dock="Right" Text="Sort by" Style="{StaticResource Secondary}" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search apps" ToolTip="Search by name or publisher"/>
            </DockPanel>

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding Message, Converter={StaticResource StringToVis}}"/>
            <DockPanel Margin="0,0,0,12" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
            </DockPanel>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         AutomationProperties.Name="Reading the list of apps"/>

            <TextBlock Text="No apps match." Style="{StaticResource Secondary}" Margin="0,0,0,12"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource RowTemplate}"
                          AutomationProperties.Name="Installed apps"/>

            <Expander IsExpanded="False" HorizontalContentAlignment="Stretch" Margin="0,8,0,8"
                      Visibility="{Binding HasSystemParts, Converter={StaticResource BoolToVis}}">
                <Expander.Header>
                    <TextBlock Text="{Binding SystemPartsHeader}" Style="{StaticResource CardTitle}" Margin="0"
                               AutomationProperties.Name="{Binding SystemPartsHeader}"/>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding SystemParts}" ItemTemplate="{StaticResource RowTemplate}" Margin="0,8,0,0"
                              AutomationProperties.Name="System parts"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
