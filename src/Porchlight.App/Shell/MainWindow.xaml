<Window x:Class="Porchlight.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Porchlight.App.Shell"
        d:DataContext="{d:DesignInstance shell:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Porchlight" Height="720" Width="1180" MinHeight="600" MinWidth="900"
        Icon="/Assets/porchlight.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,20,16,16">
                    <Image Source="/Assets/porchlight-icon.png" Width="24" Height="24" Margin="0,0,8,0"/>
                    <TextBlock Text="Porchlight" Style="{StaticResource CardTitle}" FontSize="18"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Padding="12" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding AdminStatusText}" Style="{StaticResource Secondary}"
                                   Margin="4,0,4,8" TextWrapping="Wrap"/>
                        <Button Content="Restart as admin"
                                Command="{Binding RestartElevatedCommand}"
                                Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVis}}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Content="Set up optional features"
                                Command="{Binding OpenSetupCommand}"
                                HorizontalAlignment="Stretch"/>
                        <Button Content="Notifications"
                                Command="{Binding OpenNotificationsCommand}"
                                AutomationProperties.Name="Notification settings"
                                HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Secondary}"
                                   FontSize="11" Margin="4,8,4,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Pinned pages (e.g. "Get help"): their own group at the very bottom of the rail,
                     above the admin block, separated and styled distinctly - see
                     PageCategoryCatalog. Docked before the fill ListBox below so it stacks just
                     above the (already Bottom-docked) admin block. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Margin="12,4,12,4"/>
                    <!-- SelectedItem is deliberately OneWay (Source->Target only, see
                         MainWindow.xaml.cs): the actual user-click -> SelectedPage direction, and
                         clearing MainNavList's selection when this list gets one, are both handled
                         explicitly in code-behind instead. A TwoWay binding here would let clearing
                         the OTHER list's selection (setting its SelectedIndex to -1) round-trip
                         back through the shared SelectedPage property and clobber it to null -
                         since both lists are bound to that one property, that silently blanked the
                         content area right after picking "Get help". -->
                    <ListBox x:Name="PinnedNavList" ItemsSource="{Binding PinnedCategories}"
                             SelectedItem="{Binding SelectedCategory, Mode=OneWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Accent-colored icon only - the label uses the same, normal
                                         (theme-default) text brush as the main nav list just below,
                                         so this pinned item still reads as clickable rather than
                                         disabled; only IsSelected/IsMouseOver (handled identically
                                         to the main list, via the same default ListBoxItem style -
                                         the container style below only adds an automation name) should change
                                         its appearance. -->
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}" Style="{StaticResource Icon}"
                                               FontSize="16" Margin="4,0,12,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- SelectedItem is OneWay here too - see PinnedNavList's comment above. -->
                <ListBox x:Name="MainNavList" ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory, Mode=OneWay}"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Style="{StaticResource Icon}"
                                           FontSize="16" Margin="4,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="8" Padding="6,2" Margin="8,0,0,0"
                                        Visibility="{Binding Badge, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content: tab strip (only for a category with more than one page) above the page.
             SelectedItem is OneWay for the same reason as the rail lists - see MainWindow.xaml.cs. -->
        <DockPanel Grid.Column="1" Margin="24">
            <ListBox x:Name="TabStrip" DockPanel.Dock="Top" Style="{StaticResource TabStripList}"
                     ItemsSource="{Binding SelectedCategory.Pages}"
                     SelectedItem="{Binding SelectedCategory.SelectedPage, Mode=OneWay}"
                     Visibility="{Binding SelectedCategory.HasTabs, Converter={StaticResource BoolToVis}}"
                     AutomationProperties.Name="Page tabs">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource TabStripItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding TabTitle}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="6,2" Margin="8,0,0,0"
                                    Visibility="{Binding Badge, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ContentControl Content="{Binding SelectedPageView}"/>
        </DockPanel>
    </Grid>
</Window>
