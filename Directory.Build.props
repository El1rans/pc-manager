<Project>

  <PropertyGroup>
    <!-- Single source of the app's version: read by Porchlight.App (assembly/file version, shown
         in the sidebar footer) and by installer/Porchlight.iss (via /DMyAppVersion=<Version> from
         the CI/release workflows). Bump this and CHANGELOG.md together - see docs/RELEASING.md. -->
    <Version>0.1.0</Version>
    <!-- Embedded in every assembly's PE version resource (ProductName/CompanyName) - must match
         docs/signing/app.xml's and docs/signing/installer.xml's product-name="Porchlight"
         metadata restriction (SignPath Foundation requires artifact metadata restrictions), and
         installer/Porchlight.iss's VersionInfoProductName. -->
    <Product>Porchlight</Product>
    <Company>El1rans</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
